rules_version = '2';

// 말하는 서술형 수학 노트 - Storage 보안 규칙 (Blaze 요금제로 Storage를 켠 경우)
// Firebase 콘솔 > Storage > 규칙 탭에 붙여넣고 "게시"하세요.
// 파일 경로: academies/{학원ID}/submissions/{올린 사람 uid}/{시각}.webm|jpg
service firebase.storage {
  match /b/{bucket}/o {
    match /academies/{academyId}/submissions/{uid}/{file} {
      // 본인이 올린 파일 또는 그 학원 선생님만 읽기
      allow get: if request.auth != null
                 && (request.auth.uid == uid || request.auth.uid == academyId);
      allow list: if request.auth != null && request.auth.uid == academyId;
      // 그 학원에 등록된 학생 기기(또는 선생님)가 자기 폴더에만, 영상/사진 50MB 이하
      allow create: if request.auth != null && request.auth.uid == uid
                    && (request.auth.uid == academyId
                        || firestore.exists(/databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)))
                    && request.resource.size < 50 * 1024 * 1024
                    && (request.resource.contentType.matches('video/.*')
                        || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && request.auth.uid == academyId;
    }
  }
}
